# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local docker-compose:    mongodb://mongo:27017/temple
# MongoDB Atlas (prod):    mongodb+srv://<user>:<password>@<cluster-url>/temple?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/temple

# JWT secret used to sign admin login tokens - change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Razorpay (payment gateway) - get real keys from https://dashboard.razorpay.com/app/keys
# Use the test keys while developing; switch to live keys only once you've completed
# Razorpay's KYC/activation for the temple's account.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# One-time bootstrap admin account created by the seed script
ADMIN_EMAIL=admin@srilakshmivenkateswara.org
ADMIN_PASSWORD=change-me-immediately
