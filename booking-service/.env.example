# Server
PORT=8000

# MongoDB connection - deliberately a separate logical database from the
# Node backend's, even though it can be the same MongoDB server, to keep the
# two services independently owning their own data.
# Local docker-compose / Kubernetes: mongodb://mongo:27017/temple_bookings
MONGO_URI=mongodb://localhost:27017/temple_bookings

# Must be the SAME value as the Node backend's JWT_SECRET (backend/.env).
# This lets one admin login work across both services.
JWT_SECRET=change-this-to-a-long-random-secret

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
