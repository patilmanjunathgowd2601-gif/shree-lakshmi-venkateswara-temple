# Base URL of the backend API. In docker-compose this is proxied via nginx,
# so for local docker use a relative path. For plain `npm run dev` against a
# locally running backend, use http://localhost:5000
VITE_API_URL=/api

# Base URL of the Python booking-service (separate microservice). Same idea
# as VITE_API_URL above.
VITE_BOOKING_API_URL=/booking-api
